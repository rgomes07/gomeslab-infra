# ==============================================================================
# Vaultwarden & PostgreSQL - Template de Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com valores fortes antes do deploy.
# ==============================================================================

# Domínio público de acesso (HTTPS)
DOMAIN=https://vault.gomeslab.com.br

# Credenciais do Banco de Dados PostgreSQL
POSTGRES_USER=vaultwarden
POSTGRES_PASSWORD=ALTERE_PARA_UMA_SENHA_FORTE_DB
POSTGRES_DB=vaultwarden

# String de conexão completa (deve refletir usuário, senha e banco acima)
DATABASE_URL=postgresql://vaultwarden:ALTERE_PARA_UMA_SENHA_FORTE_DB@vaultwarden-db:5432/vaultwarden

# Token do painel /admin (gere com: openssl rand -base64 48)
ADMIN_TOKEN=ALTERE_PARA_UM_TOKEN_ARGON2_OU_BASE64_FORTE

# Configurações de segurança e registro
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
WEBSOCKET_ENABLED=true
